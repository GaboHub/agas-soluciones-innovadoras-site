---
import { getEntry, render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProductCard from '../components/ProductCard.astro';
import Resenas from '../components/Resenas.astro';
import Faq from '../components/Faq.astro';
import ConstelacionMarca from '../components/ConstelacionMarca.astro';
import GlifoCategoria from '../components/GlifoCategoria.astro';
import Icono from '../components/Icono.tsx';
import { site } from '../lib/site';
import { faqsGlobales } from '../lib/faqs';
import { getProductosDeCategoria, getProductosDestacados } from '../lib/productos';
import { resolveImagen, resolveLogo, optimizedAbsoluteUrl } from '../lib/images';
import { buildOrganization, buildWebSite } from '../lib/seo';

const inicio = await getEntry('paginas', 'inicio');
if (!inicio) throw new Error('Falta la página inicio');
const { Content } = await render(inicio);

const destacados = await getProductosDestacados();
const categoriasConImagen = await Promise.all(
  site.categorias.map(async (categoria) => {
    const productos = await getProductosDeCategoria(categoria.slug);
    return { categoria, imagen: resolveImagen(productos[0].data.imagenes[0]) };
  }),
);

const faqsTeaser = faqsGlobales.slice(0, 3);

const title = `${site.nombre} — ${site.tagline}`;
const description = site.descripcion;

const logoUrl = await optimizedAbsoluteUrl(resolveLogo());
const jsonLd = [buildOrganization(logoUrl), buildWebSite()];

const [heroAntes, heroDespues] = site.hero.titulo.split(site.hero.acentuada);

const sellosIconos = ['check', 'camion', 'ubicacion'] as const;
import { ANCHOS_TARJETA, SIZES_TARJETA } from '../lib/imagenes-tarjeta';
---

<BaseLayout title={title} description={description} path="/" jsonLd={jsonLd}>
  <section
    class="relative overflow-hidden px-4 py-16 text-white md:py-24"
    style="background: radial-gradient(120% 60% at 85% 0%, color-mix(in srgb, var(--color-acento) 35%, transparent), transparent 60%), radial-gradient(100% 60% at 10% 100%, color-mix(in srgb, var(--color-destacado) 12%, transparent), transparent 60%), linear-gradient(170deg, var(--color-primario), var(--color-primario-oscuro));"
  >
    <div class="relative mx-auto grid max-w-6xl gap-12 md:grid-cols-2 md:items-center">
      <div class="flex flex-col items-center gap-6 text-center md:items-start md:text-left">
        <span class="rounded-full border border-destacado px-4 py-1.5 font-texto text-sm font-bold text-destacado">
          {site.hero.chip}
        </span>
        <h1 class="font-titulos text-3xl font-bold leading-tight md:text-5xl">
          {heroAntes}<span class="text-destacado">{site.hero.acentuada}</span>{heroDespues}
        </h1>
        <p class="max-w-xl font-texto text-lg text-white/82 md:text-xl md:leading-normal">{site.hero.bajada}</p>
        <div class="flex flex-wrap justify-center gap-3 md:justify-start">
          <a
            href="/productos/"
            class="rounded-xl bg-white px-7 py-3 font-texto text-base font-bold text-primario shadow-md motion-safe:transition-transform motion-safe:hover:scale-105 active:translate-y-[2px]"
          >
            Ver catálogo
          </a>
          <a
            href={site.mercadolibre.tienda}
            target="_blank"
            rel="noopener"
            class="rounded-xl border-2 border-white/45 px-7 py-3 font-texto text-base font-bold text-white transition-colors hover:bg-white/10 active:translate-y-[2px]"
          >
            {site.ctaHeader}
          </a>
        </div>
        <ul class="flex flex-col gap-2 p-0 font-texto text-sm font-bold text-white/90 sm:flex-row sm:flex-wrap sm:justify-center md:justify-start">
          {
            site.sellosConfianza.map((sello, indice) => (
              <li class="flex items-center gap-2">
                <Icono nombre={sellosIconos[indice]} className="h-4 w-4 text-destacado" />
                {sello}
              </li>
            ))
          }
        </ul>
      </div>

      <ConstelacionMarca class="justify-self-center" leyenda={site.hero.leyendaConstelacion} />
    </div>
  </section>

  <section id="categorias" aria-labelledby="categorias-titulo" class="px-4 py-14">
    <div class="mx-auto max-w-6xl">
      <h2 id="categorias-titulo" class="text-center font-titulos text-3xl font-bold text-tinta">
        Explora por categoría
      </h2>
      <p class="mx-auto mt-2 max-w-2xl text-center font-texto text-tinta/70">
        Accesorios para tus consolas y tu celular, listos para despacho a todo Chile.
      </p>

      <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {
          categoriasConImagen.map(({ categoria, imagen }) => (
            <a
              href={`/categorias/${categoria.slug}/`}
              class="group flex flex-col overflow-hidden rounded-3xl bg-white shadow-sm ring-1 ring-black/5 motion-safe:transition-transform motion-safe:hover:-translate-y-1 hover:shadow-lg"
            >
              <div class="flex items-center justify-center bg-white p-4">
                <Image
                  src={imagen}
                  alt={`Accesorios de ${categoria.nombre}`}
                  width={480}
                  height={480}
                  widths={ANCHOS_TARJETA}
                  sizes={SIZES_TARJETA}
                  class="h-40 w-auto object-contain sm:h-48"
                />
              </div>
              <div class="flex flex-1 flex-col gap-2 border-t border-primario-claro p-5">
                <div class="flex items-center gap-3">
                  <span class="flex h-16 w-16 shrink-0 items-center justify-center rounded-[26%] bg-primario-claro text-primario">
                    <GlifoCategoria slug={categoria.slug} class="h-8 w-8" />
                  </span>
                  <p class="font-titulos text-lg font-bold text-tinta">{categoria.nombre}</p>
                </div>
                <p class="font-texto text-sm text-tinta/80">{categoria.resumen}</p>
                <span class="mt-auto inline-flex items-center gap-1 pt-2 font-texto text-sm font-bold text-acento-oscuro group-hover:text-primario">
                  Ver {categoria.productos.length} productos
                  <Icono nombre="flecha-derecha" className="h-4 w-4" />
                </span>
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section aria-labelledby="destacados-titulo" class="bg-white px-4 py-14">
    <div class="mx-auto max-w-6xl">
      <h2 id="destacados-titulo" class="text-center font-titulos text-3xl font-bold text-tinta">
        Los favoritos de nuestros compradores
      </h2>
      <p class="mx-auto mt-2 max-w-2xl text-center font-texto text-tinta/70">
        Los productos con más reseñas reales en Mercado Libre.
      </p>
      <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {
          destacados.map((producto, indice) => (
            <ProductCard
              prioridad={indice < 4}
              slug={producto.data.slug}
              titulo={producto.data.titulo}
              categoriaNombre={site.categorias.find((c) => c.slug === producto.data.categoria)?.nombre ?? ''}
              precioReferencial={producto.data.precioReferencial}
              imagen={resolveImagen(producto.data.imagenes[0])}
              reviews={producto.data.reviews}
            />
          ))
        }
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-4xl px-4 py-12">
    <div class="contenido-md contenido-md-con-check">
      <Content />
    </div>
  </section>

  <Resenas />

  <section class="px-4 py-14">
    <div class="mx-auto flex max-w-3xl flex-col items-center gap-3 rounded-3xl bg-primario-claro px-6 py-10 text-center">
      <h2 class="font-titulos text-2xl font-bold text-tinta md:text-3xl">¿No sabes cuál elegir?</h2>
      <p class="font-texto text-tinta/80">
        Nuestras guías te ayudan a identificar tu modelo y elegir el accesorio exacto.
      </p>
      <a
        href="/guias/"
        class="rounded-xl bg-primario px-7 py-3 font-texto text-base font-bold text-white shadow-md motion-safe:transition-transform motion-safe:hover:scale-105 active:translate-y-[2px]"
      >
        Ver todas las guías
      </a>
    </div>
  </section>

  <section class="bg-white px-4 py-2">
    <Faq items={faqsTeaser} titulo="Preguntas frecuentes" />
    <div class="mx-auto max-w-4xl pb-10">
      <a href="/preguntas-frecuentes/" class="inline-flex min-h-11 items-center gap-1 font-texto font-bold text-acento-oscuro hover:text-primario hover:underline">
        Ver todas las preguntas frecuentes
        <Icono nombre="flecha-derecha" className="h-4 w-4" />
      </a>
    </div>
  </section>

  <section class="px-4 py-14">
    <div class="mx-auto flex max-w-3xl flex-col items-center gap-4 rounded-3xl bg-primario px-6 py-10 text-center text-white">
      <h2 class="font-titulos text-2xl font-bold md:text-3xl">¿Listo para equipar tu setup?</h2>
      <p class="font-texto text-white/90">
        Encuentra todo nuestro catálogo con precios vigentes y despacho a todo Chile.
      </p>
      <a
        href={site.mercadolibre.tienda}
        target="_blank"
        rel="noopener"
        class="rounded-xl bg-white px-7 py-3 font-texto text-base font-bold text-primario shadow-md motion-safe:transition-transform motion-safe:hover:scale-105 active:translate-y-[2px]"
      >
        {site.ctaHeader}
      </a>
    </div>
  </section>
</BaseLayout>
