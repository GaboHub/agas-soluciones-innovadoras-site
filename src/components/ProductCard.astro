---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Estrellas from './Estrellas.astro';
import { formatearPrecioCLP } from '../lib/formato';

interface Props {
  slug: string;
  titulo: string;
  categoriaNombre: string;
  precioReferencial: number;
  imagen: ImageMetadata;
  reviews?: {
    promedio: number;
    cantidad: number;
  };
}

const { slug, titulo, categoriaNombre, precioReferencial, imagen, reviews } = Astro.props;
---

<a
  href={`/productos/${slug}/`}
  class="group flex flex-col overflow-hidden rounded-3xl bg-white shadow-sm ring-1 ring-black/5 transition-transform hover:-translate-y-1 hover:shadow-lg"
>
  <div class="flex items-center justify-center bg-white p-4">
    <Image
      src={imagen}
      alt={titulo}
      width={480}
      height={480}
      class="h-40 w-auto object-contain sm:h-48"
    />
  </div>
  <div class="flex flex-1 flex-col gap-2 border-t border-primario-claro p-5">
    <p class="font-texto text-xs font-bold tracking-wide text-destacado-oscuro uppercase">{categoriaNombre}</p>
    <p class="font-titulos text-base font-bold text-tinta">{titulo}</p>
    {reviews && reviews.cantidad > 0 && <Estrellas promedio={reviews.promedio} cantidad={reviews.cantidad} />}
    <p class="mt-auto pt-2 font-titulos text-lg font-bold text-primario">
      {formatearPrecioCLP(precioReferencial)}
      <span class="block font-texto text-xs font-normal text-tinta/60">Precio referencial</span>
    </p>
    <span class="font-texto text-sm font-bold text-acento-oscuro group-hover:text-primario">Ver producto →</span>
  </div>
</a>
