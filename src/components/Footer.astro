---
import { Image } from 'astro:assets';
import { site } from '../lib/site';
import { resolveImagen } from '../lib/images';

const lockupBlanco = resolveImagen('agas-lockup-blanco.svg');
const anio = new Date().getFullYear();
const [usuarioCorreo, dominioCorreo] = site.contacto.email.split('@');
---

<footer class="mt-16 pb-24 md:pb-0 border-t border-primario-claro bg-primario-oscuro text-white">
  <div class="mx-auto max-w-6xl px-4 py-10">
    <div class="grid gap-8 md:grid-cols-3">
      <div>
        <Image src={lockupBlanco} alt={`Logo de ${site.nombre}`} width={210} height={56} class="h-12 w-auto" />
        <p class="mt-3 text-sm text-white/90">{site.claim}</p>
        <p class="mt-4 text-sm text-white/90">{site.footer}</p>
      </div>
      <div class="text-sm">
        <p class="font-titulos text-base font-bold">Catálogo</p>
        <ul class="mt-2 flex list-none flex-col gap-2 p-0 md:gap-1">
          <li><a href="/productos/" class="flex min-h-11 items-center hover:underline md:min-h-0 md:py-1">Todos los productos</a></li>
          {
            site.categorias.map((categoria) => (
              <li>
                <a href={`/categorias/${categoria.slug}/`} class="flex min-h-11 items-center hover:underline md:min-h-0 md:py-1">
                  {categoria.nombre}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
      <div class="text-sm">
        <p class="font-titulos text-base font-bold">Compra y contacto</p>
        <ul class="mt-2 flex list-none flex-col gap-2 p-0 md:gap-1">
          <li>
            <a href={site.mercadolibre.tienda} target="_blank" rel="noopener" class="flex min-h-11 items-center hover:underline md:min-h-0 md:py-1">
              Tienda en Mercado Libre
            </a>
          </li>
          <li>
            <a href={site.mercadolibre.paginaOficial} target="_blank" rel="noopener" class="flex min-h-11 items-center hover:underline md:min-h-0 md:py-1">
              {site.ctaPaginaOficial}
            </a>
          </li>
          <li>
            <a href={site.redes.instagram} target="_blank" rel="noopener" class="flex min-h-11 items-center hover:underline md:min-h-0 md:py-1">
              Instagram
            </a>
          </li>
          <li><a href="/promociones/" class="flex min-h-11 items-center hover:underline md:min-h-0 md:py-1">Promociones</a></li>
          <li><a href="/guias/" class="flex min-h-11 items-center hover:underline md:min-h-0 md:py-1">Guías</a></li>
          <li><a href="/preguntas-frecuentes/" class="flex min-h-11 items-center hover:underline md:min-h-0 md:py-1">Preguntas frecuentes</a></li>
          <li><a href="/contacto/" class="flex min-h-11 items-center hover:underline md:min-h-0 md:py-1">Contacto</a></li>
          <li><a href="/terminos-y-condiciones/" class="flex min-h-11 items-center hover:underline md:min-h-0 md:py-1">Términos y condiciones</a></li>
        </ul>
        <p class="mt-3 text-white/80">{site.ubicacion}</p>
        <p class="mt-1 text-white/80">{site.cobertura}</p>
        <p class="mt-4 text-white/80">
          {site.contacto.ventasVolumen} <a href={`mailto:${site.contacto.email}`} class="break-words font-semibold text-destacado hover:underline">{usuarioCorreo}<wbr />@{dominioCorreo}</a>
        </p>
      </div>
    </div>
    <p class="mt-8 border-t border-white/20 pt-6 text-center text-xs text-white/80">
      © {anio} {site.razonSocial}. Todos los derechos reservados.
    </p>
  </div>
</footer>
