---
interface Props {
  class?: string;
  leyenda: string;
}

const { class: className = '', leyenda } = Astro.props;

const baldosas = [
  { delay: '0s' },
  { delay: '-1.5s' },
  { delay: '-3s' },
  { delay: '-4.5s' },
];
---

<div class:list={['flex flex-col items-center gap-6', className]} aria-hidden="true">
  <div class="grid rotate-45 grid-cols-2 grid-rows-2 gap-4">
    <div
      class="motion-safe:animate-[flotar_6s_ease-in-out_infinite_alternate] flex h-24 w-24 items-center justify-center rounded-[26%] bg-white shadow-lg md:h-28 md:w-28"
      style={`animation-delay: ${baldosas[0].delay}`}
    >
      <svg
        class="h-12 w-12 -rotate-45 md:h-14 md:w-14"
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 96 96"
        fill="none"
      >
        <g class="text-primario">
          <path d="M26 74 L46 26 L66 74" stroke="currentColor" stroke-width="6" stroke-linecap="round" stroke-linejoin="round" />
        </g>
        <g class="text-acento">
          <path d="M37 59 L55 59" stroke="currentColor" stroke-width="6" stroke-linecap="round" />
        </g>
      </svg>
    </div>

    <div
      class="motion-safe:animate-[flotar_6s_ease-in-out_infinite_alternate] flex h-24 w-24 items-center justify-center rounded-[26%] bg-white/7 md:h-28 md:w-28"
      style={`animation-delay: ${baldosas[1].delay}`}
    >
      <svg
        class="h-11 w-11 -rotate-45 text-primario-claro md:h-12 md:w-12"
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <path d="M4 15c0-3.5 1.5-7 8-7s8 3.5 8 7c0 2-1.4 3.5-3.2 3.5-1.3 0-2-.7-2.3-1.7L14 15h-4l-.5 1.8c-.3 1-1 1.7-2.3 1.7C5.4 18.5 4 17 4 15Z" />
        <circle cx="9" cy="11.3" r="0.9" fill="currentColor" stroke="none" />
        <circle cx="15" cy="11.3" r="0.9" fill="currentColor" stroke="none" />
      </svg>
    </div>

    <div
      class="motion-safe:animate-[flotar_6s_ease-in-out_infinite_alternate] flex h-24 w-24 items-center justify-center rounded-[26%] bg-white/7 md:h-28 md:w-28"
      style={`animation-delay: ${baldosas[2].delay}`}
    >
      <svg
        class="h-11 w-11 -rotate-45 text-destacado md:h-12 md:w-12"
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <path d="M4 15v-3a8 8 0 0 1 16 0v3" />
        <rect x="2.5" y="14" width="4" height="6" rx="1.5" />
        <rect x="17.5" y="14" width="4" height="6" rx="1.5" />
      </svg>
    </div>

    <div
      class="motion-safe:animate-[flotar_6s_ease-in-out_infinite_alternate] flex h-24 w-24 items-center justify-center rounded-[26%] bg-white/7 md:h-28 md:w-28"
      style={`animation-delay: ${baldosas[3].delay}`}
    >
      <svg
        class="h-11 w-11 -rotate-45 text-white/55 md:h-12 md:w-12"
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <path d="M12 3.5 19 6v5.5c0 4.3-2.9 7.5-7 8.5-4.1-1-7-4.2-7-8.5V6Z" />
        <path d="m9 12 2 2 4-4.5" />
      </svg>
    </div>
  </div>

  <p class="font-texto text-xs font-bold uppercase tracking-[0.2em] text-white/60">{leyenda}</p>
</div>
