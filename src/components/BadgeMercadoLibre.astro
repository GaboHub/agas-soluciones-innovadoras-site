---
import { resenas } from '../lib/resenas';

interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
const esVerde = resenas.mercadolibre.nivel === '5_green';
---

<a
  href={resenas.mercadolibre.url}
  target="_blank"
  rel="noopener"
  class:list={[
    'inline-flex flex-wrap items-center justify-center gap-2 rounded-full bg-white px-5 py-2.5 font-texto text-sm font-bold text-tinta shadow-sm ring-1 ring-black/5 transition-transform hover:scale-105',
    className,
  ]}
>
  {
    esVerde && (
      <span class="inline-flex items-center gap-1.5 text-emerald-700">
        <span aria-hidden="true" class="h-2.5 w-2.5 rounded-full bg-emerald-500" />
        Reputación verde en Mercado Libre
      </span>
    )
  }
  <span class="text-tinta/70">
    {resenas.mercadolibre.transacciones} ventas · {resenas.promedioGeneral.toFixed(1)}★ ({resenas.totalReviews} reseñas)
  </span>
</a>
