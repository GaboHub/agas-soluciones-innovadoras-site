---
import { promociones, getCuponesPublicables, getCampanasPublicables } from '../lib/promociones';
import { formatearFecha } from '../lib/formato';
import BadgeEstadoPromocion from './BadgeEstadoPromocion.astro';

const cupones = getCuponesPublicables();
const campanas = getCampanasPublicables();
const hayPromos = cupones.length + campanas.length > 0;
---

{
  hayPromos && (
    <section
      id="promociones-resumen"
      aria-labelledby="promociones-resumen-titulo"
      class="rounded-3xl bg-primario-claro p-6 md:p-8"
    >
      <h2 id="promociones-resumen-titulo" class="font-titulos text-2xl font-bold text-tinta">
        Promociones en nuestra tienda de Mercado Libre
      </h2>
      <p class="mt-2 font-texto text-sm font-bold text-tinta">{promociones.aclaracion}</p>
      <ul class="mt-5 grid list-none gap-3 p-0 sm:grid-cols-2">
        {cupones.map((cupon) => (
          <li data-promo class="flex items-start justify-between gap-3 rounded-2xl bg-white p-4">
            <p class="font-texto font-bold text-tinta">
              {cupon.nombre} — {cupon.porcentaje}%
            </p>
            <BadgeEstadoPromocion estado={cupon.estado} />
          </li>
        ))}
        {campanas.map((campana) => (
          <li data-promo class="flex items-start justify-between gap-3 rounded-2xl bg-white p-4">
            <div>
              <p class="font-texto font-bold text-tinta">{campana.nombre}</p>
              <p class="mt-1 font-texto text-xs font-bold text-tinta/60">
                {formatearFecha(campana.desde)} – {formatearFecha(campana.hasta)}
              </p>
            </div>
            <BadgeEstadoPromocion estado={campana.estado} />
          </li>
        ))}
      </ul>
      <a
        href="/promociones/"
        data-cta="ver-promociones"
        class="mt-5 inline-flex items-center gap-1 font-texto text-sm font-bold text-acento-oscuro hover:text-primario hover:underline"
      >
        Ver todas las promociones →
      </a>
    </section>
  )
}
