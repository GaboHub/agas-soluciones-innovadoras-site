---
interface Props {
  slug: string;
  class?: string;
}

const { slug, class: className = '' } = Astro.props;
---

<svg
  class:list={['pointer-events-none select-none', className]}
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  {
    slug === 'nintendo-switch' && (
      <>
        <rect x="2.5" y="4" width="6" height="16" rx="3" />
        <rect x="15.5" y="4" width="6" height="16" rx="3" />
        <circle cx="5.5" cy="9" r="1.2" fill="currentColor" stroke="none" />
        <path d="M4.5 15h2M5.5 14v2" />
        <circle cx="18.5" cy="9" r="0.9" fill="currentColor" stroke="none" />
        <circle cx="18.5" cy="12.5" r="0.9" fill="currentColor" stroke="none" />
        <path d="M9 8h6M9 16h6" />
      </>
    )
  }
  {
    slug === 'playstation-5' && (
      <>
        <path d="M4 15c0-3.5 1.5-7 8-7s8 3.5 8 7c0 2-1.4 3.5-3.2 3.5-1.3 0-2-.7-2.3-1.7L14 15h-4l-.5 1.8c-.3 1-1 1.7-2.3 1.7C5.4 18.5 4 17 4 15Z" />
        <circle cx="9" cy="11.3" r="0.9" fill="currentColor" stroke="none" />
        <circle cx="15" cy="11.3" r="0.9" fill="currentColor" stroke="none" />
      </>
    )
  }
  {
    slug === 'audio' && (
      <>
        <path d="M4 15v-3a8 8 0 0 1 16 0v3" />
        <rect x="2.5" y="14" width="4" height="6" rx="1.5" />
        <rect x="17.5" y="14" width="4" height="6" rx="1.5" />
      </>
    )
  }
  {
    !['nintendo-switch', 'playstation-5', 'audio'].includes(slug) && (
      <>
        <path d="M6.5 18 12 6l5.5 12" />
        <path d="M9 13.5h6" />
      </>
    )
  }
</svg>
