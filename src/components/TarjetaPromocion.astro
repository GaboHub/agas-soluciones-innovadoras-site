---
import { formatearFecha } from '../lib/formato';
import type { EstadoPromocion } from '../lib/promociones';
import BadgeEstadoPromocion from './BadgeEstadoPromocion.astro';

interface Props {
  nombre: string;
  descripcion: string;
  estado: EstadoPromocion;
  desde: string;
  hasta: string;
  href: string;
}

const { nombre, descripcion, estado, desde, hasta, href } = Astro.props;
---

<article data-promo class="flex flex-col gap-3 rounded-3xl bg-white p-6 shadow-sm ring-1 ring-black/5">
  <div class="flex items-start justify-between gap-3">
    <h3 class="font-titulos text-lg font-bold text-tinta">{nombre}</h3>
    <BadgeEstadoPromocion estado={estado} />
  </div>
  <p class="font-texto text-sm text-tinta/70">{descripcion}</p>
  <p class="font-texto text-xs font-bold text-tinta/60">
    {formatearFecha(desde)} – {formatearFecha(hasta)}
  </p>
  <a
    href={href}
    target="_blank"
    rel="noopener"
    class="mt-auto inline-flex items-center justify-center rounded-xl bg-primario px-5 py-2.5 text-center font-texto text-sm font-bold text-white transition-transform hover:scale-105 active:translate-y-[2px]"
  >
    Ver en Mercado Libre
  </a>
</article>
