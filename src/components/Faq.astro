---
import type { FaqItem } from '../lib/faqs';

interface Props {
  items: FaqItem[];
  titulo?: string;
}

interface Segmento {
  texto: string;
  esLink: boolean;
}

function segmentarConLinks(texto: string): Segmento[] {
  const segmentos: Segmento[] = [];
  for (const parte of texto.split(/(https?:\/\/\S+)/g)) {
    if (!parte) continue;
    if (!/^https?:\/\//.test(parte)) {
      segmentos.push({ texto: parte, esLink: false });
      continue;
    }
    const url = parte.replace(/[.,;:!?)]+$/, '');
    segmentos.push({ texto: url, esLink: true });
    const resto = parte.slice(url.length);
    if (resto) segmentos.push({ texto: resto, esLink: false });
  }
  return segmentos;
}

const { items, titulo = 'Preguntas frecuentes' } = Astro.props;
---

<section class="mx-auto max-w-4xl px-4 py-12" aria-labelledby="faq-titulo">
  <h2 id="faq-titulo" class="font-titulos text-2xl font-extrabold text-tinta md:text-3xl">
    {titulo}
  </h2>
  <div class="mt-6 flex flex-col gap-3">
    {
      items.map((item) => (
        <details class="group rounded-2xl bg-white p-5 shadow-sm ring-1 ring-black/5">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-titulos font-bold text-tinta [&::-webkit-details-marker]:hidden">
            <span>{item.pregunta}</span>
            <span aria-hidden="true" class="shrink-0 text-primario-oscuro transition-transform group-open:rotate-45">
              +
            </span>
          </summary>
          <p class="mt-3 font-texto text-tinta/80">
            {
              segmentarConLinks(item.respuesta).map((segmento) =>
                segmento.esLink ? (
                  <a
                    href={segmento.texto}
                    target="_blank"
                    rel="noopener"
                    class="font-bold text-acento-oscuro underline hover:text-primario"
                  >
                    {segmento.texto}
                  </a>
                ) : (
                  segmento.texto
                ),
              )
            }
          </p>
        </details>
      ))
    }
  </div>
</section>
