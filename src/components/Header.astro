---
import { Image } from 'astro:assets';
import { site } from '../lib/site';
import { resolveImagen } from '../lib/images';

const lockup = resolveImagen('agas-lockup.svg');

const enlaces = [
  { href: '/', etiqueta: 'Inicio' },
  { href: '/productos/', etiqueta: 'Productos' },
  { href: '/guias/', etiqueta: 'Guías' },
  { href: '/preguntas-frecuentes/', etiqueta: 'Preguntas frecuentes' },
  { href: '/contacto/', etiqueta: 'Contacto' },
];

const currentPath = Astro.url.pathname;
---

<header class="sticky top-0 z-40 border-b border-primario-claro bg-fondo/95 backdrop-blur">
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-3 px-4 py-3">
    <a href="/" class="flex shrink-0 items-center" aria-label={`${site.nombre} — Inicio`}>
      <Image src={lockup} alt={`Logo de ${site.nombre}`} width={180} height={48} class="h-10 w-auto md:h-11" />
    </a>

    <nav aria-label="Navegación principal" class="hidden md:flex md:items-center md:gap-6">
      {
        enlaces.map((enlace) => (
          <a
            href={enlace.href}
            class:list={[
              'font-texto font-semibold text-tinta transition-colors hover:text-primario',
              currentPath === enlace.href && 'text-primario',
            ]}
          >
            {enlace.etiqueta}
          </a>
        ))
      }
      <a
        href={site.mercadolibre.tienda}
        target="_blank"
        rel="noopener"
        class="rounded-full bg-primario px-4 py-2 font-texto font-bold text-white shadow-sm transition-transform hover:scale-105"
      >
        {site.ctaHeader}
      </a>
    </nav>

    <details class="relative md:hidden" id="menu-movil">
      <summary
        class="flex h-10 w-10 cursor-pointer list-none items-center justify-center rounded-full bg-primario-claro text-tinta [&::-webkit-details-marker]:hidden"
        aria-label="Abrir menú de navegación"
      >
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" class="h-6 w-6">
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <line x1="3" y1="12" x2="21" y2="12"></line>
          <line x1="3" y1="18" x2="21" y2="18"></line>
        </svg>
      </summary>
      <nav
        aria-label="Navegación móvil"
        class="absolute right-0 top-12 flex w-64 flex-col gap-1 rounded-2xl border border-primario-claro bg-white p-3 shadow-lg"
      >
        {
          enlaces.map((enlace) => (
            <a href={enlace.href} class="rounded-xl px-3 py-2 font-texto font-semibold text-tinta hover:bg-primario-claro">
              {enlace.etiqueta}
            </a>
          ))
        }
        <a
          href={site.mercadolibre.tienda}
          target="_blank"
          rel="noopener"
          class="mt-1 rounded-xl bg-primario px-3 py-2 text-center font-texto font-bold text-white"
        >
          {site.ctaHeader}
        </a>
      </nav>
    </details>
  </div>
</header>

<script>
  const menu = document.getElementById('menu-movil') as HTMLDetailsElement | null;
  menu?.addEventListener('click', (event) => {
    const target = event.target as HTMLElement;
    if (target.tagName === 'A') {
      menu.open = false;
    }
  });
  document.addEventListener('click', (event) => {
    if (menu && menu.open && !menu.contains(event.target as Node)) {
      menu.open = false;
    }
  });
</script>
