---
import { Image } from 'astro:assets';
import Icono from './Icono.tsx';
import { site } from '../lib/site';
import { resolveImagen } from '../lib/images';

const lockup = resolveImagen('agas-lockup.svg');

const enlaces = [
  { href: '/', etiqueta: 'Inicio' },
  { href: '/productos/', etiqueta: 'Productos' },
  { href: '/promociones/', etiqueta: 'Promociones' },
  { href: '/guias/', etiqueta: 'Guías' },
  { href: '/preguntas-frecuentes/', etiqueta: 'Preguntas frecuentes' },
  { href: '/contacto/', etiqueta: 'Contacto' },
];

const currentPath = Astro.url.pathname;
const rutaDeSeccion = currentPath.startsWith('/categorias/') ? '/productos/' : currentPath;
const esActivo = (href: string) => (href === '/' ? rutaDeSeccion === '/' : rutaDeSeccion.startsWith(href));
---

<header class="sticky top-0 z-40 border-b border-primario-claro bg-fondo/95 backdrop-blur">
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-3 px-4 py-3">
    <a href="/" class="flex min-h-11 shrink-0 items-center" aria-label={`${site.nombre} — Inicio`}>
      <Image src={lockup} alt={`Logo de ${site.nombre}`} width={180} height={48} loading="eager" class="h-10 w-auto md:h-11" />
    </a>

    <nav aria-label="Navegación principal" class="hidden lg:flex lg:items-center lg:gap-3 xl:gap-6">
      {
        enlaces.map((enlace) => (
          <a
            href={enlace.href}
            aria-current={esActivo(enlace.href) ? 'page' : undefined}
            class:list={[
              'whitespace-nowrap font-texto text-sm font-semibold transition-colors xl:text-base hover:text-primario',
              esActivo(enlace.href) ? 'text-primario underline decoration-2 underline-offset-8' : 'text-tinta',
            ]}
          >
            {enlace.etiqueta}
          </a>
        ))
      }
      <a
        href={site.mercadolibre.tienda}
        target="_blank"
        rel="noopener"
        class="whitespace-nowrap rounded-xl bg-primario px-3 py-2 font-texto text-sm font-bold xl:px-4 xl:text-base text-white shadow-sm motion-safe:transition-transform motion-safe:hover:scale-105 active:translate-y-[2px]"
      >
        {site.ctaHeader}
      </a>
    </nav>

    <details class="relative lg:hidden" id="menu-movil">
      <summary
        class="flex size-11 list-none items-center justify-center rounded-full bg-primario-claro text-tinta motion-safe:transition-transform active:translate-y-[2px] [&::-webkit-details-marker]:hidden"
        aria-label="Abrir menú de navegación"
      >
        <Icono nombre="menu" className="h-6 w-6" />
      </summary>
      <nav
        aria-label="Navegación móvil"
        class="absolute right-0 top-12 flex w-64 flex-col gap-2 rounded-2xl border border-primario-claro bg-white p-3 shadow-lg"
      >
        {
          enlaces.map((enlace) => (
            <a
              href={enlace.href}
              aria-current={esActivo(enlace.href) ? 'page' : undefined}
              class:list={[
                'rounded-xl px-3 py-3 font-texto font-semibold hover:bg-primario-claro',
                esActivo(enlace.href) ? 'bg-primario-claro text-primario underline decoration-2 underline-offset-4' : 'text-tinta',
              ]}
            >
              {enlace.etiqueta}
            </a>
          ))
        }
        <a
          href={site.mercadolibre.tienda}
          target="_blank"
          rel="noopener"
          class="mt-1 rounded-xl bg-primario px-3 py-3 text-center font-texto font-bold text-white active:translate-y-[2px]"
        >
          {site.ctaHeader}
        </a>
      </nav>
    </details>
  </div>
</header>

<script>
  const menu = document.getElementById('menu-movil') as HTMLDetailsElement | null;
  menu?.addEventListener('click', (event) => {
    const target = event.target as HTMLElement;
    if (target.tagName === 'A') {
      menu.open = false;
    }
  });
  menu?.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && menu.open) {
      menu.open = false;
      menu.querySelector('summary')?.focus();
    }
  });
  document.addEventListener('click', (event) => {
    if (menu && menu.open && !menu.contains(event.target as Node)) {
      menu.open = false;
    }
  });
</script>
